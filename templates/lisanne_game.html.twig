<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>✨ Leer Letters! ✨</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;700;900&display=swap');

    :root {
      --pink-light: #ffe0f0;
      --pink:       #ff85c2;
      --pink-deep:  #e0408a;
      --pink-dark:  #c0266e;
      --pink-soft:  #ffc2e0;
      --yellow:     #fff176;
      --purple:     #d580ff;
      --white:      #fff9fc;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: linear-gradient(135deg, #ffe4f3 0%, #ffd6ee 50%, #ffcce8 100%);
      font-family: 'Nunito', sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Floating bubbles */
    .bubble {
      position: fixed;
      border-radius: 50%;
      opacity: 0.18;
      animation: floatUp linear infinite;
      pointer-events: none;
      z-index: 0;
    }
    @keyframes floatUp {
      0%   { transform: translateY(110vh) scale(1);   opacity: 0.18; }
      100% { transform: translateY(-20vh) scale(1.2); opacity: 0;    }
    }

    /* ── HEADER ── */
    header {
      position: relative;
      z-index: 10;
      background: linear-gradient(90deg, #ff85c2, #e0408a, #d580ff, #ff85c2);
      background-size: 300% 100%;
      animation: gradientShift 5s ease infinite;
      padding: 18px 24px 14px;
      text-align: center;
      box-shadow: 0 6px 20px rgba(224, 64, 138, 0.45);
    }
    @keyframes gradientShift {
      0%   { background-position: 0%   50%; }
      50%  { background-position: 100% 50%; }
      100% { background-position: 0%   50%; }
    }
    header h1 {
      font-family: 'Fredoka One', cursive;
      font-size: clamp(2rem, 6vw, 3.6rem);
      color: #fff;
      text-shadow: 3px 3px 0 #c0266e, 5px 5px 0 rgba(0,0,0,0.1);
      letter-spacing: 2px;
      animation: bounce 2s ease infinite;
    }
    @keyframes bounce {
      0%, 100% { transform: translateY(0);   }
      50%       { transform: translateY(-6px); }
    }
    header p {
      color: #ffe0f0;
      font-size: clamp(0.9rem, 2.5vw, 1.2rem);
      font-weight: 700;
      margin-top: 4px;
    }

    /* ── SCREENS ── */
    .screen { display: none; }
    .screen.active { display: block; }

    main {
      position: relative;
      z-index: 1;
      max-width: 1080px;
      margin: 0 auto;
      padding: 36px 20px 60px;
      display: flex;
      gap: 28px;
      align-items: flex-start;
    }
    .game-area   { flex: 1; min-width: 0; }
    .cabinet-area {
      width: 250px;
      flex-shrink: 0;
      position: sticky;
      top: 20px;
    }
    @media (max-width: 820px) {
      main { flex-direction: column; }
      .cabinet-area { width: 100%; position: static; order: -1; }
    }

    /* ── START SCREEN ── */
    .start-card {
      background: var(--white);
      border-radius: 32px;
      border: 4px solid var(--pink-soft);
      padding: 44px 32px;
      text-align: center;
      box-shadow: 0 10px 40px rgba(224,64,138,0.18);
      animation: slideIn 0.4s ease;
    }
    .start-emoji {
      display: block;
      font-size: 7rem;
      margin-bottom: 16px;
      animation: bounce 2s ease infinite;
    }
    .start-card h2 {
      font-family: 'Fredoka One', cursive;
      font-size: 2.4rem;
      color: var(--pink-dark);
      margin-bottom: 12px;
    }
    .start-card p {
      font-size: 1.2rem;
      color: #a0507a;
      line-height: 1.6;
      margin-bottom: 36px;
    }
    .start-btn {
      background: linear-gradient(135deg, var(--pink), var(--pink-deep));
      color: #fff;
      border: none;
      border-radius: 50px;
      padding: 18px 64px;
      font-family: 'Fredoka One', cursive;
      font-size: 1.8rem;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(224,64,138,0.4);
      transition: transform 0.18s, box-shadow 0.18s;
    }
    .start-btn:hover  { transform: scale(1.08); box-shadow: 0 10px 28px rgba(224,64,138,0.5); }
    .start-btn:active { transform: scale(0.97); }

    /* ── GAME HEADER BAR ── */
    .game-topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--white);
      border-radius: 20px;
      border: 3px solid var(--pink-soft);
      padding: 12px 20px;
      margin-bottom: 14px;
      box-shadow: 0 4px 14px rgba(224,64,138,0.1);
    }
    .topbar-progress {
      font-family: 'Fredoka One', cursive;
      font-size: 1.15rem;
      color: var(--pink-deep);
    }
    .topbar-score {
      font-family: 'Fredoka One', cursive;
      font-size: 1.2rem;
      color: var(--pink-dark);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .progress-bar-wrap {
      height: 12px;
      background: var(--pink-light);
      border-radius: 10px;
      border: 2px solid var(--pink-soft);
      overflow: hidden;
      margin-bottom: 22px;
    }
    .progress-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--pink), var(--pink-deep));
      border-radius: 10px;
      transition: width 0.5s ease;
    }

    /* ── QUESTION CARD ── */
    .question-card {
      background: var(--white);
      border-radius: 32px;
      border: 4px solid var(--pink-soft);
      padding: 32px 28px 28px;
      text-align: center;
      box-shadow: 0 10px 40px rgba(224,64,138,0.15);
      position: relative;
      overflow: hidden;
      transition: border-color 0.3s, box-shadow 0.3s;
    }
    .question-card.correct-glow {
      border-color: #66bb6a;
      box-shadow: 0 0 0 6px rgba(102,187,106,0.25), 0 10px 40px rgba(76,175,80,0.2);
    }
    .question-card.wrong-shake {
      animation: shake 0.4s ease;
    }
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20%       { transform: translateX(-10px); }
      40%       { transform: translateX(10px); }
      60%       { transform: translateX(-8px); }
      80%       { transform: translateX(8px); }
    }

    #q-big-emoji {
      display: block;
      font-size: 7.5rem;
      line-height: 1;
      margin-bottom: 6px;
    }
    #q-big-letter {
      display: block;
      font-family: 'Fredoka One', cursive;
      font-size: 8rem;
      line-height: 1;
      color: var(--pink-deep);
      text-shadow: 4px 4px 0 var(--pink-soft), 6px 6px 0 rgba(0,0,0,0.06);
      margin-bottom: 6px;
    }
    #q-word-label {
      font-family: 'Fredoka One', cursive;
      font-size: 2.2rem;
      color: var(--pink-dark);
      margin-bottom: 4px;
    }
    .blank-slot {
      display: inline-block;
      min-width: 40px;
      background: var(--pink-light);
      border: 3px solid var(--pink-deep);
      border-radius: 10px;
      color: var(--pink-deep);
      padding: 0 6px;
      margin-right: 3px;
      vertical-align: middle;
      font-size: 2.2rem;
    }
    .last-letter-hint {
      color: var(--pink-deep);
      text-decoration: underline;
      text-underline-offset: 5px;
      text-decoration-thickness: 3px;
    }
    #q-prompt {
      font-size: 1.1rem;
      font-weight: 700;
      color: #b06090;
      margin-bottom: 26px;
    }

    /* ── ANSWER BUTTONS ── */
    .answers-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .ans-btn {
      background: linear-gradient(135deg, var(--pink-light), var(--pink-soft));
      border: 3px solid var(--pink);
      border-radius: 20px;
      padding: 18px 10px;
      font-family: 'Fredoka One', cursive;
      font-size: 2rem;
      color: var(--pink-dark);
      cursor: pointer;
      transition: transform 0.18s, box-shadow 0.18s;
      box-shadow: 0 4px 12px rgba(224,64,138,0.15);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      line-height: 1.2;
    }
    .ans-btn:hover:not(:disabled) {
      transform: translateY(-5px) scale(1.04);
      box-shadow: 0 8px 22px rgba(224,64,138,0.3);
      border-color: var(--pink-deep);
    }
    .ans-btn:active:not(:disabled) { transform: scale(0.97); }
    .ans-btn:disabled { cursor: default; }
    .ans-btn .btn-word-emoji { font-size: 2rem; }
    .ans-btn .btn-word-text  { font-size: 1.05rem; }

    .ans-btn.is-correct {
      background: linear-gradient(135deg, #a5d6a7, #4caf50) !important;
      border-color: #2e7d32 !important;
      color: #fff !important;
      transform: scale(1.06);
      box-shadow: 0 0 0 4px rgba(76,175,80,0.3);
    }
    .ans-btn.is-wrong {
      background: linear-gradient(135deg, #ef9a9a, #e53935) !important;
      border-color: #b71c1c !important;
      color: #fff !important;
    }

    /* ── FEEDBACK ── */
    .feedback-row {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-top: 20px;
      gap: 14px;
      min-height: 80px;
    }
    #feedback-msg {
      font-family: 'Fredoka One', cursive;
      font-size: 1.45rem;
      min-height: 36px;
      transition: opacity 0.3s;
    }
    #feedback-msg.correct { color: #2e7d32; }
    #feedback-msg.wrong   { color: #c62828; }

    @keyframes popIn {
      from { transform: scale(0.6); opacity: 0; }
      to   { transform: scale(1);   opacity: 1; }
    }

    #countdown-wrap {
      width: 100%;
      height: 10px;
      background: var(--pink-light);
      border-radius: 6px;
      border: 2px solid var(--pink-soft);
      overflow: hidden;
      display: none;
    }
    #countdown-fill {
      height: 100%;
      width: 100%;
      background: linear-gradient(90deg, var(--pink), var(--pink-deep));
      border-radius: 4px;
    }
    #countdown-fill.running {
      animation: countdownShrink 2s linear forwards;
    }
    @keyframes countdownShrink {
      from { width: 100%; }
      to   { width: 0%; }
    }

    /* ── END SCREEN ── */
    .end-card {
      background: var(--white);
      border-radius: 32px;
      border: 4px solid var(--pink-soft);
      padding: 44px 32px;
      text-align: center;
      box-shadow: 0 10px 40px rgba(224,64,138,0.2);
      animation: slideIn 0.4s ease;
    }
    @keyframes slideIn {
      from { transform: translateY(30px); opacity: 0; }
      to   { transform: translateY(0);    opacity: 1; }
    }
    #end-emoji {
      display: block;
      font-size: 5.5rem;
      margin-bottom: 12px;
      animation: spinIn 0.5s ease;
    }
    @keyframes spinIn {
      from { transform: rotate(-25deg) scale(0.4); opacity: 0; }
      to   { transform: rotate(0deg)   scale(1);   opacity: 1; }
    }
    .end-card h2 {
      font-family: 'Fredoka One', cursive;
      font-size: 2.4rem;
      color: var(--pink-dark);
      margin-bottom: 10px;
    }
    .end-card p {
      font-size: 1.2rem;
      color: #a0507a;
      margin-bottom: 18px;
      line-height: 1.5;
    }
    #end-score-num {
      font-family: 'Fredoka One', cursive;
      font-size: 3.2rem;
      color: var(--pink-deep);
      margin-bottom: 10px;
    }
    #end-stars {
      font-size: 2.6rem;
      letter-spacing: 5px;
      margin-bottom: 30px;
    }
    .play-again-btn {
      background: linear-gradient(135deg, var(--pink), var(--pink-deep));
      color: #fff;
      border: none;
      border-radius: 50px;
      padding: 16px 56px;
      font-family: 'Fredoka One', cursive;
      font-size: 1.6rem;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(224,64,138,0.4);
      transition: transform 0.18s, box-shadow 0.18s;
    }
    .play-again-btn:hover  { transform: scale(1.08); box-shadow: 0 10px 28px rgba(224,64,138,0.5); }
    .play-again-btn:active { transform: scale(0.97); }

    /* ── SPARKLES ── */
    .sparkle-el {
      position: fixed;
      pointer-events: none;
      z-index: 5000;
      animation: sparkleOut var(--dur, 0.9s) ease-out forwards;
    }
    @keyframes sparkleOut {
      0%   { transform: translate(0, 0)                    scale(1.3); opacity: 1; }
      100% { transform: translate(var(--tx), var(--ty))    scale(0);   opacity: 0; }
    }

    /* ── CONFETTI ── */
    .confetti-piece {
      position: fixed;
      width: 12px; height: 12px;
      border-radius: 3px;
      pointer-events: none;
      z-index: 4000;
      animation: confettiFall var(--dur2, 1.5s) ease-out var(--delay, 0s) forwards;
    }
    @keyframes confettiFall {
      0%   { transform: translateY(-30px)  rotate(0deg);   opacity: 1; }
      100% { transform: translateY(100vh)  rotate(720deg); opacity: 0; }
    }

    /* ── MUSIC BUTTON ── */
    #music-btn {
      position: fixed;
      top: 20px; right: 20px;
      z-index: 1000;
      background: var(--yellow);
      border: 4px solid var(--pink-deep);
      border-radius: 50px;
      padding: 10px 18px;
      font-size: 1.6rem;
      line-height: 1;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(224,64,138,0.4);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    #music-btn:hover { transform: scale(1.12); box-shadow: 0 6px 20px rgba(224,64,138,0.55); }

    /* ── PRIZE CABINET ── */
    .cabinet-card {
      background: var(--white);
      border-radius: 26px;
      border: 3px solid var(--pink-soft);
      padding: 18px 14px 20px;
      box-shadow: 0 8px 30px rgba(224,64,138,0.14);
    }
    .cabinet-title {
      font-family: 'Fredoka One', cursive;
      font-size: 1.25rem;
      color: var(--pink-dark);
      text-align: center;
      padding-bottom: 12px;
      margin-bottom: 14px;
      border-bottom: 2px dashed var(--pink-soft);
    }
    #cabinet-prizes-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
      margin-bottom: 10px;
    }
    .cabinet-prize {
      background: var(--pink-light);
      border: 2px solid var(--pink-soft);
      border-radius: 14px;
      padding: 10px 6px 8px;
      text-align: center;
      animation: popIn 0.4s ease;
    }
    .cabinet-prize .pr-emoji { display: block; font-size: 2rem; line-height: 1; }
    .cabinet-prize .pr-name  { display: block; font-family: 'Fredoka One', cursive; font-size: 0.72rem; color: var(--pink-dark); margin-top: 4px; }
    #cabinet-empty-msg {
      text-align: center;
      font-size: 0.9rem;
      color: #c078a8;
      font-weight: 700;
      padding: 10px 6px;
      line-height: 1.5;
    }
    #cabinet-next-msg {
      text-align: center;
      font-size: 0.82rem;
      font-weight: 700;
      color: #b06090;
      background: var(--pink-light);
      border-radius: 10px;
      padding: 7px 6px;
      margin-top: 8px;
    }

    /* ── PRIZE SELECTION MODAL ── */
    #prize-modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(200,60,130,0.4);
      backdrop-filter: blur(6px);
      z-index: 2000;
      align-items: center;
      justify-content: center;
    }
    #prize-modal.open { display: flex; }
    .prize-modal-box {
      background: var(--white);
      border-radius: 32px;
      border: 4px solid var(--pink);
      padding: 36px 26px 30px;
      width: min(92vw, 460px);
      text-align: center;
      box-shadow: 0 20px 60px rgba(224,64,138,0.4);
      animation: slideIn 0.3s ease;
    }
    .prize-modal-box h2 {
      font-family: 'Fredoka One', cursive;
      font-size: 2rem;
      color: var(--pink-dark);
      margin-bottom: 6px;
    }
    .prize-modal-box p {
      color: #a0507a;
      font-size: 1.05rem;
      margin-bottom: 22px;
    }
    .prize-choices-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
    .prize-choice-btn {
      background: linear-gradient(135deg, var(--pink-light), var(--pink-soft));
      border: 3px solid var(--pink);
      border-radius: 18px;
      padding: 14px 6px 10px;
      cursor: pointer;
      transition: transform 0.18s, box-shadow 0.18s;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
    }
    .prize-choice-btn:hover {
      transform: scale(1.1);
      box-shadow: 0 6px 18px rgba(224,64,138,0.35);
      border-color: var(--pink-deep);
    }
    .prize-choice-btn:active { transform: scale(0.96); }
    .prize-choice-btn .pc-emoji { font-size: 2.8rem; line-height: 1; }
    .prize-choice-btn .pc-name  { font-family: 'Fredoka One', cursive; font-size: 0.85rem; color: var(--pink-dark); }

    /* ── FOOTER ── */
    footer {
      text-align: center;
      padding: 24px;
      color: var(--pink-deep);
      font-weight: 700;
      font-size: 1rem;
      position: relative;
      z-index: 1;
    }
  </style>
</head>
<body>

  <script>
    const bubbleColors = ['#ff85c2','#ffc2e0','#d580ff','#ffb6d9','#ff69b4'];
    for (let i = 0; i < 18; i++) {
      const b = document.createElement('div');
      b.className = 'bubble';
      const size = 30 + Math.random() * 80;
      b.style.cssText = `width:${size}px;height:${size}px;background:${bubbleColors[i%bubbleColors.length]};left:${Math.random()*100}vw;animation-duration:${8+Math.random()*14}s;animation-delay:-${Math.random()*20}s;`;
      document.body.appendChild(b);
    }
  </script>

  <button id="music-btn" onclick="toggleMusic()" title="Muziek aan/uit">🔇</button>

  <header>
    <h1>✨ Leer Letters! ✨</h1>
    <p>Welke letter hoort bij het woord? Leer het op een leuke manier! 🌸🐾</p>
  </header>

  <!-- Prize selection modal -->
  <div id="prize-modal">
    <div class="prize-modal-box">
      <h2>🎉 10 sterren!</h2>
      <p>Kies een prijs voor je prijzenkast!</p>
      <div class="prize-choices-grid" id="prize-choices-grid"></div>
    </div>
  </div>

  <main>
   <div class="game-area">

    <!-- ── START ── -->
    <div id="start-screen" class="screen active">
      <div class="start-card">
        <span class="start-emoji">📚</span>
        <h2>Klaar om te leren?</h2>
        <p>
          Kijk naar het plaatje en het woord.<br>
          Kies de juiste letter en win sterren! ⭐<br>
          Er zijn <strong>10 vragen</strong> per rondje!
        </p>
        <button class="start-btn" onclick="startGame()">Spelen! 🎉</button>
      </div>
    </div>

    <!-- ── GAME ── -->
    <div id="game-screen" class="screen">
      <div class="game-topbar">
        <div class="topbar-progress" id="topbar-progress">Vraag 1 van 10</div>
        <div class="topbar-score">⭐ <span id="topbar-score">0</span></div>
      </div>
      <div class="progress-bar-wrap">
        <div class="progress-bar-fill" id="progress-fill" style="width:0%"></div>
      </div>
      <div class="question-card" id="question-card">
        <span id="q-big-emoji"></span>
        <span id="q-big-letter" style="display:none"></span>
        <div id="q-word-label"></div>
        <div id="q-prompt"></div>
        <div class="answers-grid" id="answers-grid"></div>
      </div>
      <div class="feedback-row">
        <div id="feedback-msg"></div>
        <div id="countdown-wrap"><div id="countdown-fill"></div></div>
      </div>
    </div>

    <!-- ── END ── -->
    <div id="end-screen" class="screen">
      <div class="end-card">
        <span id="end-emoji">🏆</span>
        <h2 id="end-title">Geweldig!</h2>
        <p  id="end-msg">Je hebt het spel uitgespeeld!</p>
        <div id="end-score-num"></div>
        <div id="end-stars"></div>
        <button class="play-again-btn" onclick="startGame()">Speel opnieuw! 🎊</button>
      </div>
    </div>

   </div><!-- /game-area -->

   <aside class="cabinet-area">
     <div class="cabinet-card">
       <div class="cabinet-title">🏆 Mijn Prijzenkast</div>
       <div id="cabinet-prizes-grid"></div>
       <div id="cabinet-empty-msg">Verdien 10 ⭐ voor je eerste prijs! 🎁</div>
       <div id="cabinet-next-msg"></div>
     </div>
   </aside>

  </main>

  <footer>Leer letters met plezier! 💖</footer>

  <script>
    /* ── WORD BANK ── */
    const WORDS = [
      { word: 'appel',      emoji: '🍎', letter: 'A' },
      { word: 'aap',        emoji: '🐒', letter: 'A' },
      { word: 'auto',       emoji: '🚗', letter: 'A' },
      { word: 'aardbei',    emoji: '🍓', letter: 'A' },
      { word: 'beer',       emoji: '🐻', letter: 'B' },
      { word: 'ballon',     emoji: '🎈', letter: 'B' },
      { word: 'banaan',     emoji: '🍌', letter: 'B' },
      { word: 'boot',       emoji: '⛵', letter: 'B' },
      { word: 'eend',       emoji: '🦆', letter: 'E' },
      { word: 'egel',       emoji: '🦔', letter: 'E' },
      { word: 'ei',         emoji: '🥚', letter: 'E' },
      { word: 'fiets',      emoji: '🚲', letter: 'F' },
      { word: 'giraf',      emoji: '🦒', letter: 'G' },
      { word: 'hond',       emoji: '🐶', letter: 'H' },
      { word: 'huis',       emoji: '🏠', letter: 'H' },
      { word: 'hart',       emoji: '❤️',  letter: 'H' },
      { word: 'ijs',        emoji: '🍦', letter: 'I' },
      { word: 'kat',        emoji: '🐱', letter: 'K' },
      { word: 'kikker',     emoji: '🐸', letter: 'K' },
      { word: 'konijn',     emoji: '🐰', letter: 'K' },
      { word: 'leeuw',      emoji: '🦁', letter: 'L' },
      { word: 'maan',       emoji: '🌙', letter: 'M' },
      { word: 'muis',       emoji: '🐭', letter: 'M' },
      { word: 'neushoorn',  emoji: '🦏', letter: 'N' },
      { word: 'noot',       emoji: '🌰', letter: 'N' },
      { word: 'olifant',    emoji: '🐘', letter: 'O' },
      { word: 'octopus',    emoji: '🐙', letter: 'O' },
      { word: 'paard',      emoji: '🐴', letter: 'P' },
      { word: 'pinguïn',    emoji: '🐧', letter: 'P' },
      { word: 'pizza',      emoji: '🍕', letter: 'P' },
      { word: 'regenboog',  emoji: '🌈', letter: 'R' },
      { word: 'roos',       emoji: '🌹', letter: 'R' },
      { word: 'slang',      emoji: '🐍', letter: 'S' },
      { word: 'ster',       emoji: '⭐', letter: 'S' },
      { word: 'schildpad',  emoji: '🐢', letter: 'S' },
      { word: 'tijger',     emoji: '🐯', letter: 'T' },
      { word: 'tulp',       emoji: '🌷', letter: 'T' },
      { word: 'taart',      emoji: '🎂', letter: 'T' },
      { word: 'uil',        emoji: '🦉', letter: 'U' },
      { word: 'vis',        emoji: '🐟', letter: 'V' },
      { word: 'vlinder',    emoji: '🦋', letter: 'V' },
      { word: 'vos',        emoji: '🦊', letter: 'V' },
      { word: 'wolf',       emoji: '🐺', letter: 'W' },
      { word: 'walvis',     emoji: '🐳', letter: 'W' },
      { word: 'wolk',       emoji: '☁️',  letter: 'W' },
      { word: 'zebra',      emoji: '🦓', letter: 'Z' },
      { word: 'zon',        emoji: '☀️',  letter: 'Z' },
    ];

    const ALL_LETTERS = [...new Set(WORDS.map(w => w.letter))].sort();
    const TOTAL = 10;

    /* ── PRIZES ── */
    const ALL_PRIZES = [
      { emoji: '🧸', name: 'Teddybeer'  }, { emoji: '🦄', name: 'Eenhoorn'   },
      { emoji: '👑', name: 'Kroon'      }, { emoji: '🌈', name: 'Regenboog'  },
      { emoji: '🍭', name: 'Lolly'      }, { emoji: '🎀', name: 'Strik'      },
      { emoji: '💎', name: 'Diamant'    }, { emoji: '🎠', name: 'Draaimolen' },
      { emoji: '🌟', name: 'Superster'  }, { emoji: '🦋', name: 'Vlinder'    },
      { emoji: '🐉', name: 'Draak'      }, { emoji: '🎁', name: 'Cadeautje'  },
      { emoji: '🎡', name: 'Reuzenrad'  }, { emoji: '🌸', name: 'Bloesem'    },
      { emoji: '🏆', name: 'Trofee'     }, { emoji: '🦊', name: 'Vosje'      },
      { emoji: '🍦', name: 'IJsje'      }, { emoji: '🎈', name: 'Ballon'     },
      { emoji: '💫', name: 'Schietster' }, { emoji: '🎪', name: 'Circus'     },
    ];
    let totalCorrect     = 0;
    let cabinet          = [];
    let prizeMilestone   = 0;
    let pendingChoices   = [];

    let questions = [], current = 0, score = 0, answered = false, countdownTimer = null;

    /* ── HELPERS ── */
    function shuffle(arr) {
      const a = [...arr];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    // Letters die kinderen vaak door elkaar halen
    const CONFUSABLE = {
      A: ['E','O','U'],  B: ['D','P','R'],  E: ['F','I','A'],
      F: ['E','V','P'],  G: ['J','K','C'],  H: ['N','M','K'],
      I: ['E','J','L'],  K: ['H','G','R'],  L: ['I','J','T'],
      M: ['N','W','H'],  N: ['M','H','U'],  O: ['U','A','E'],
      P: ['B','D','R'],  R: ['P','B','K'],  S: ['Z','C','F'],
      T: ['D','L','J'],  U: ['V','N','O'],  V: ['U','F','W'],
      W: ['M','V','N'],  Z: ['S','T','C'],
    };

    function wrongLettersFor(correct, count) {
      const preferred = (CONFUSABLE[correct] || []).filter(l => ALL_LETTERS.includes(l));
      const fallback  = ALL_LETTERS.filter(l => l !== correct && !preferred.includes(l));
      return shuffle([...preferred, ...shuffle(fallback)]).slice(0, count);
    }

    /* ── QUESTION GENERATION ── */
    function buildQuestions() {
      const picked = shuffle(WORDS).slice(0, TOTAL);
      return picked.map(word => {
        /* Altijd: eerste letter is weg → welke letter ontbreekt? */
        return {
          type: 'missing',
          word,
          options: shuffle([word.letter, ...wrongLettersFor(word.letter, 3)]),
          correct: word.letter,
        };
      });
    }

    /* ── SCREENS ── */
    function showScreen(id) {
      document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
      document.getElementById(id).classList.add('active');
    }

    function startGame() {
      questions = buildQuestions();
      current = 0;
      score = 0;
      answered = false;
      showScreen('game-screen');
      renderQuestion();
      startMusic();
      renderCabinetProgress();
    }

    /* ── RENDER ── */
    function renderQuestion() {
      answered = false;
      const q = questions[current];

      document.getElementById('topbar-progress').textContent = `Vraag ${current + 1} van ${TOTAL}`;
      document.getElementById('topbar-score').textContent = score;
      document.getElementById('progress-fill').style.width = `${(current / TOTAL) * 100}%`;

      const card = document.getElementById('question-card');
      card.classList.remove('correct-glow', 'wrong-shake');

      const emojiEl  = document.getElementById('q-big-emoji');
      const letterEl = document.getElementById('q-big-letter');
      const wordLbl  = document.getElementById('q-word-label');
      const prompt   = document.getElementById('q-prompt');

      if (q.type === 'letter') {
        emojiEl.textContent    = q.word.emoji;
        emojiEl.style.display  = 'block';
        letterEl.style.display = 'none';
        wordLbl.textContent    = q.word.word;
        prompt.textContent     = 'Welke letter begint dit woord?';

      } else if (q.type === 'word') {
        letterEl.textContent   = q.word.letter;
        letterEl.style.display = 'block';
        emojiEl.style.display  = 'none';
        wordLbl.textContent    = '';
        prompt.textContent     = `Welk woord begint met de letter ${q.word.letter}?`;

      } else if (q.type === 'last') {
        emojiEl.textContent    = q.word.emoji;
        emojiEl.style.display  = 'block';
        letterEl.style.display = 'none';
        // Onderstreep de laatste letter als hint
        const w = q.word.word;
        wordLbl.innerHTML = w.slice(0, -1) + `<span class="last-letter-hint">${w.slice(-1)}</span>`;
        prompt.textContent = 'Met welke letter eindigt dit woord?';

      } else if (q.type === 'missing') {
        emojiEl.textContent    = q.word.emoji;
        emojiEl.style.display  = 'block';
        letterEl.style.display = 'none';
        wordLbl.innerHTML      = `<span class="blank-slot">?</span>${q.word.word.slice(1)}`;
        prompt.textContent     = 'Welke letter ontbreekt?';
      }

      const grid = document.getElementById('answers-grid');
      grid.innerHTML = '';
      q.options.forEach(opt => {
        const btn = document.createElement('button');
        btn.className = 'ans-btn';
        if (q.type === 'word') {
          btn.innerHTML = `<span class="btn-word-emoji">${opt.emoji}</span><span class="btn-word-text">${opt.word}</span>`;
        } else {
          btn.textContent = opt;
        }
        btn.addEventListener('click', () => handleAnswer(opt, btn, q));
        grid.appendChild(btn);
      });

      clearTimeout(countdownTimer);
      const wrap = document.getElementById('countdown-wrap');
      const fill = document.getElementById('countdown-fill');
      wrap.style.display = 'none';
      fill.classList.remove('running');

      const msg = document.getElementById('feedback-msg');
      msg.textContent = '';
      msg.className = '';
    }

    /* ── ANSWER ── */
    function handleAnswer(chosen, btn, q) {
      if (answered) return;
      answered = true;

      const correct = chosen === q.correct;

      document.querySelectorAll('.ans-btn').forEach((b, i) => {
        b.disabled = true;
        if (q.options[i] === q.correct) b.classList.add('is-correct');
        if (b === btn && !correct) b.classList.add('is-wrong');
      });

      const card = document.getElementById('question-card');
      const msg  = document.getElementById('feedback-msg');

      if (correct) {
        score++;
        totalCorrect++;
        renderCabinetProgress();
        card.classList.add('correct-glow');
        msg.textContent = ['Super goed! 🌟', 'Geweldig! ⭐', 'Wauw, top! 🎉', 'Bravo! 💖', 'Fantastisch! 🏆'][Math.floor(Math.random() * 5)];
        msg.className = 'correct';
        const el = document.getElementById(q.type === 'word' ? 'q-big-letter' : 'q-big-emoji');
        const r  = el.getBoundingClientRect();
        sparkle(r.left + r.width / 2, r.top + r.height / 2);
        playCorrectSound();
      } else {
        card.classList.add('wrong-shake');
        const correctLabel = q.type === 'word' ? q.correct.word : q.correct;
        msg.textContent = `Oeps! Het goede antwoord was: ${correctLabel}`;
        msg.className = 'wrong';
      }

      document.getElementById('topbar-score').textContent = score;
      startCountdown();
    }

    function startCountdown() {
      const wrap = document.getElementById('countdown-wrap');
      const fill = document.getElementById('countdown-fill');
      wrap.style.display = 'block';
      fill.classList.remove('running');
      void fill.offsetWidth;
      fill.classList.add('running');
      countdownTimer = setTimeout(nextQuestion, 2000);
    }

    function nextQuestion() {
      if (Math.floor(totalCorrect / 10) > prizeMilestone) {
        prizeMilestone++;
        showPrizeSelection();
        return;
      }
      current++;
      if (current >= TOTAL) {
        showEndScreen();
      } else {
        renderQuestion();
      }
    }

    /* ── END SCREEN ── */
    function showEndScreen() {
      document.getElementById('progress-fill').style.width = '100%';
      showScreen('end-screen');

      document.getElementById('end-score-num').textContent = `${score} / ${TOTAL}`;

      let emoji, title, msg, stars;
      if (score === TOTAL)   { emoji = '🏆'; title = 'Perfect! Geweldig!';    msg = 'Jij bent een echte letter-ster! 🌟'; stars = '⭐⭐⭐⭐⭐'; }
      else if (score >= 8)   { emoji = '🎉'; title = 'Bijna perfect!';        msg = 'Waanzinnig goed gedaan! 🎊';          stars = '⭐⭐⭐⭐'; }
      else if (score >= 6)   { emoji = '😊'; title = 'Goed gedaan!';          msg = 'Je leert zo snel! Probeer het nog een keer! 💪'; stars = '⭐⭐⭐'; }
      else if (score >= 4)   { emoji = '🌸'; title = 'Goed geprobeerd!';      msg = 'Blijf oefenen, je wordt steeds beter! 🌈'; stars = '⭐⭐'; }
      else                   { emoji = '💖'; title = 'Blijf oefenen!';        msg = 'Elke keer gaat het een beetje beter! 🐾'; stars = '⭐'; }

      document.getElementById('end-emoji').textContent  = emoji;
      document.getElementById('end-title').textContent  = title;
      document.getElementById('end-msg').textContent    = msg;
      document.getElementById('end-stars').textContent  = stars;

      if (score >= 8) confetti();
    }

    /* ── SPARKLE EFFECT ── */
    function sparkle(cx, cy) {
      const icons = ['✨','⭐','🌟','💫','💖','🎀','🌸'];
      for (let i = 0; i < 18; i++) {
        const el  = document.createElement('div');
        el.className = 'sparkle-el';
        el.textContent = icons[i % icons.length];
        const angle  = (i / 18) * 360 + Math.random() * 15;
        const dist   = 70 + Math.random() * 130;
        const tx     = Math.cos(angle * Math.PI / 180) * dist;
        const ty     = Math.sin(angle * Math.PI / 180) * dist;
        const dur    = (0.65 + Math.random() * 0.55).toFixed(2);
        const size   = (1.2 + Math.random() * 1.1).toFixed(1);
        el.style.cssText = `left:${cx - 14}px;top:${cy - 14}px;font-size:${size}rem;--tx:${tx}px;--ty:${ty}px;--dur:${dur}s;`;
        document.body.appendChild(el);
        setTimeout(() => el.remove(), 1500);
      }
    }

    /* ── PRIZE CABINET ── */
    function showPrizeSelection() {
      const owned = new Set(cabinet.map(p => p.emoji));
      const pool  = shuffle(ALL_PRIZES.filter(p => !owned.has(p.emoji)));
      pendingChoices = pool.slice(0, 6);

      const grid = document.getElementById('prize-choices-grid');
      grid.innerHTML = pendingChoices.map((p, i) => `
        <button class="prize-choice-btn" onclick="selectPrize(${i})">
          <span class="pc-emoji">${p.emoji}</span>
          <span class="pc-name">${p.name}</span>
        </button>
      `).join('');

      document.getElementById('prize-modal').classList.add('open');
      confetti();
    }

    function selectPrize(i) {
      cabinet.push(pendingChoices[i]);
      document.getElementById('prize-modal').classList.remove('open');
      renderCabinet();
      // Continue game flow
      current++;
      if (current >= TOTAL) showEndScreen(); else renderQuestion();
    }

    function renderCabinet() {
      const grid     = document.getElementById('cabinet-prizes-grid');
      const emptyMsg = document.getElementById('cabinet-empty-msg');
      emptyMsg.style.display = cabinet.length === 0 ? 'block' : 'none';
      grid.innerHTML = cabinet.map(p => `
        <div class="cabinet-prize">
          <span class="pr-emoji">${p.emoji}</span>
          <span class="pr-name">${p.name}</span>
        </div>
      `).join('');
      renderCabinetProgress();
    }

    function renderCabinetProgress() {
      const next = document.getElementById('cabinet-next-msg');
      const toNext = 10 - (totalCorrect % 10);
      next.textContent = toNext === 10 && totalCorrect > 0
        ? 'Kies je prijs! 🎁'
        : `Nog ${toNext} ⭐ voor een prijs!`;
      next.style.display = 'block';
    }

    /* ── CORRECT ANSWER SOUND ── */
    function playCorrectSound() {
      initAudio();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      // Vrolijk oplopend akkoord: C5 → E5 → G5 → C6
      const notes = [523, 659, 784, 1047];
      const sfxGain = audioCtx.createGain();
      sfxGain.gain.value = 0.35;
      sfxGain.connect(audioCtx.destination);
      notes.forEach((freq, i) => {
        const osc  = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(sfxGain);
        osc.type = 'sine';
        osc.frequency.value = freq;
        const t = audioCtx.currentTime + i * 0.1;
        gain.gain.setValueAtTime(0, t);
        gain.gain.linearRampToValueAtTime(1, t + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.001, t + (i === 3 ? 0.55 : 0.18));
        osc.start(t);
        osc.stop(t + 0.6);
      });
    }

    /* ── BACKGROUND MUSIC (Web Audio API) ── */
    let audioCtx = null, masterGain = null, musicOn = false, noteIdx = 0, noteTimer = null;

    // Speels melodietje in C-majeur pentatoniek
    const MELODY = [
      [523, 0.20], [659, 0.20], [784, 0.20], [880, 0.40],
      [784, 0.20], [659, 0.20], [523, 0.40],
      [587, 0.20], [659, 0.20], [784, 0.20], [659, 0.40],
      [523, 0.20], [440, 0.20], [392, 0.60],
      [0,   0.35],
      [392, 0.20], [440, 0.20], [523, 0.20], [659, 0.40],
      [523, 0.20], [440, 0.20], [392, 0.40],
      [440, 0.20], [523, 0.20], [587, 0.20], [523, 0.40],
      [440, 0.20], [392, 0.20], [330, 0.60],
      [0,   0.45],
    ];

    function initAudio() {
      if (audioCtx) return;
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      masterGain = audioCtx.createGain();
      masterGain.gain.value = 0.13;
      masterGain.connect(audioCtx.destination);
    }

    function playTone(freq, dur) {
      if (!audioCtx || freq === 0) return;
      const osc  = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain);
      gain.connect(masterGain);
      osc.type = 'triangle';
      osc.frequency.value = freq;
      const t = audioCtx.currentTime;
      gain.gain.setValueAtTime(0, t);
      gain.gain.linearRampToValueAtTime(0.9, t + 0.025);
      gain.gain.exponentialRampToValueAtTime(0.001, t + dur * 0.88);
      osc.start(t);
      osc.stop(t + dur);
    }

    function scheduleNextNote() {
      if (!musicOn) return;
      const [freq, dur] = MELODY[noteIdx % MELODY.length];
      playTone(freq, dur);
      noteIdx++;
      noteTimer = setTimeout(scheduleNextNote, dur * 1000);
    }

    function startMusic() {
      initAudio();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      if (musicOn) return;
      musicOn = true;
      masterGain.gain.value = 0.13;
      noteIdx = 0;
      clearTimeout(noteTimer);
      scheduleNextNote();
      document.getElementById('music-btn').textContent = '🔊';
    }

    function toggleMusic() {
      if (!audioCtx) { startMusic(); return; }
      musicOn = !musicOn;
      document.getElementById('music-btn').textContent = musicOn ? '🔊' : '🔇';
      if (musicOn) {
        masterGain.gain.value = 0.13;
        if (audioCtx.state === 'suspended') audioCtx.resume();
        scheduleNextNote();
      } else {
        clearTimeout(noteTimer);
        masterGain.gain.setTargetAtTime(0, audioCtx.currentTime, 0.15);
      }
    }

    /* ── CONFETTI ── */
    function confetti() {
      const colors = ['#ff85c2','#d580ff','#fff176','#7de8ff','#ff6b9d','#ffe066','#a5d6a7'];
      for (let i = 0; i < 70; i++) {
        const el = document.createElement('div');
        el.className = 'confetti-piece';
        const dur   = (1.1 + Math.random() * 1.1).toFixed(2);
        const delay = (Math.random() * 0.9).toFixed(2);
        el.style.cssText = `left:${Math.random()*100}vw;background:${colors[i % colors.length]};--dur2:${dur}s;--delay:${delay}s;`;
        document.body.appendChild(el);
        setTimeout(() => el.remove(), 3200);
      }
    }
  </script>
</body>
</html>
