<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interactive Cat</title>
    <style>
        body {
            margin: 0;
            height: 100vh;
            background: #a0e7e5;
            overflow: hidden;
            cursor: pointer;
        }

        #cat {
            position: absolute;
            font-size: 50px;
            transform: translate(0, 0) scale(1);
            transition: transform 0.5s ease;
            pointer-events: none;
        }
    </style>
</head>
<body>

<div id="cat">🐱</div>

<audio id="meow-sound" src="https://www.soundjay.com/cat/cat-meow-1.mp3"></audio>

<script>
    const cat = document.getElementById('cat');
    const meow = document.getElementById('meow-sound');

    document.addEventListener('click', (event) => {
        const x = event.clientX - cat.offsetWidth / 2;
        const y = event.clientY - cat.offsetHeight / 2;

        // Play sound
        meow.currentTime = 0;
        meow.play().catch(() => console.log("Sound blocked."));

        // Apply scale animation
        cat.style.transition = "transform 0.25s ease"; // short bounce
        cat.style.transform = `translate(${x}px, ${y}px) scale(1.3)`;

        // Reset scale after animation
        setTimeout(() => {
            cat.style.transform = `translate(${x}px, ${y}px) scale(1)`;
        }, 250);
    });
</script>

</body>
</html>
